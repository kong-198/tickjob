<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kong</groupId>
        <artifactId>tickjob</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>tickjob-admin</artifactId>
    <name>tickjob-admin</name>
    <description>调度中心：任务管理、时间轮调度、执行器注册发现、触发日志</description>

    <dependencies>
        <dependency>
            <groupId>com.kong</groupId>
            <artifactId>tickjob-common</artifactId>
        </dependency>

        <!--
          调度中心内嵌一个本地执行器实例，用于「零依赖一键跑通全链路」的演示。
          tier:demo 说明见 DemoExecutorConfiguration：生产环境应把执行器部署为独立进程，
          这里只是为了让人 clone 下来就能看到任务被真实触发。
        -->
        <dependency>
            <groupId>com.kong</groupId>
            <artifactId>tickjob-executor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- local profile 免装数据库即可启动 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.kong.tickjob.admin.TickJobApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
