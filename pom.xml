<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.kong</groupId>
    <artifactId>tickjob</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>tickjob</name>
    <description>分布式任务调度平台 · 调度中心与执行器分离，时间轮驱动，支持路由策略与分片广播</description>

    <modules>
        <module>tickjob-common</module>
        <module>tickjob-executor</module>
        <module>tickjob-admin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块版本统一在这里收口，子模块不必重复写 version -->
            <dependency>
                <groupId>com.kong</groupId>
                <artifactId>tickjob-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.kong</groupId>
                <artifactId>tickjob-executor</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 时间轮与并发相关用例依赖真实时钟，禁止并行执行避免相互干扰 -->
                    <parallel>none</parallel>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
